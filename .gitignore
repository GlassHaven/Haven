# Static qemu-user loaders — fetched (pinned + sha256-verified) by core/local's
# fetchQemuLoaders Gradle task from Debian; see fetch-qemu-loaders.sh (#325).
core/local/src/main/jniLibs/*/libqemu_*.so
# Wayvnc capture-fallback shim — rebuilt by core/local's buildWayvncShim
# Gradle task from wayland-android/wayvnc-shim/libhaven_wayvnc_shim.c.
core/local/src/main/assets/wayvnc-shim/*/libhaven_wayvnc_shim.so
# haven-usb guest artifacts — rebuilt by core/local's buildHavenUsb Gradle task
# from core/local/src/main/cpp/haven-usb/ (the probe; later the LD_PRELOAD shim).
core/local/src/main/assets/haven-usb/
