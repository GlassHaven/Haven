<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- #575: the adb pairing code box must float over Android's own pairing
         dialog — the dialog generates and displays the code, so the user has to
         read it and type it at the same time. An Activity would send the dialog
         (and the code) to the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Package visibility: needed for detecting installed apps on targetSdk 30+ -->
    <queries>
        <!-- Android Terminal VM (Linux VM on Pixel 8+) -->
        <package android:name="com.android.virtualization.terminal" />
        <!-- Shizuku (privileged shell access) -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Launch intent for Terminal VM -->
        <intent>
            <action android:name="android.virtualization.VM_TERMINAL" />
        </intent>
    </queries>

    <application
        android:name=".HavenApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:extractNativeLibs="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".DeepLinkActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- step-ca renewal notification deep-link: tapping the
                 "cert expiring" notification fires haven://renew-cert/<keyId>
                 which lands here, then the activity hands the keyId off to
                 KeysScreen with a flag to auto-trigger regenerate. (#133 phase 2b) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="haven"
                    android:host="renew-cert" />
            </intent-filter>
            <!-- haven://connect deep-link: launch a connection from URI params,
                 e.g. haven://connect?host=h&user=u&port=p&transport=mosh&session=s
                 A matched saved profile connects (after a confirm); an unmatched
                 host opens the New-Connection editor pre-filled. (#305) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="haven"
                    android:host="connect" />
            </intent-filter>
        </activity>

        <activity
            android:name=".backup.PullBackupShortcutActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- One-shot resurrector for the restart_app MCP verb. Runs in its own
             process (:restart) so it can kill the main process — applying a
             staged self-update — and relaunch the app while itself foreground,
             clearing the background-activity-launch block that defeats a post-
             kill AlarmManager relaunch. Not exported; no launcher entry. -->
        <activity
            android:name=".RestartActivity"
            android:process=":restart"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Tasker / Locale / MacroDroid plugin: "Run command on a Haven
             server" (#367). The edit activity is the config screen the host
             opens when adding the action; the receiver fires when the macro
             runs. Both must be exported so the host can reach them; the
             receiver validates the config bundle before acting. -->
        <activity
            android:name="sh.haven.app.tasker.TaskerEditActivity"
            android:exported="true"
            android:label="@string/tasker_plugin_name"
            android:icon="@mipmap/ic_launcher"
            android:theme="@style/Theme.Haven"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver
            android:name="sh.haven.app.tasker.TaskerFireReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- Cloudflare Access SSH login WebView (#154). Hosts the IdP
             auth flow and captures the CF_Authorization JWT cookie. -->
        <activity
            android:name="sh.haven.feature.tunnel.CloudflareAccessLoginActivity"
            android:exported="false"
            android:label="Cloudflare Access sign in"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <service
            android:name="sh.haven.core.ssh.SshConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Long-lived SSH/Mosh/VNC/RDP/SFTP sessions and the MCP reverse tunnel they carry; user-initiated and kept alive while the connection notification is showing. dataSync was killed by Android 16 within ~10s." />
        </service>

        <provider
            android:name=".HavenDocumentsProvider"
            android:authorities="sh.haven.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- FileProvider for sharing APK files with the system package installer -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Shizuku provider for shell-level Wayland socket access (optional) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Disable WorkManager's default startup initialiser so the
             custom HiltWorkerFactory wired from HavenApp.workManagerConfiguration
             is the one in use. (#133 phase 2b) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Allow/Deny actions on the backgrounded-consent notification.
             Internal only — fired by our own PendingIntents. -->
        <receiver
            android:name=".agent.ConsentActionReceiver"
            android:exported="false" />
    </application>
</manifest>
