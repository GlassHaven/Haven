    <!-- Desktop manager: header / intro -->
    <string name="app_desktop_manager_title">Local Linux</string>
    <string name="app_desktop_compositor_title">Compositor</string>
    <string name="app_desktop_manager_description">Run a full Linux desktop inside Haven. Pick a distro, install a desktop environment (Xfce4, Openbox, or Sway), then Launch — no separate server or connection needed.</string>
    <!-- Desktop manager: package mirror (#263) -->
    <string name="app_desktop_mirror_title">Package mirror</string>
    <string name="app_desktop_mirror_description">Where distro packages are downloaded from. Pick a region closer to you for faster, more reliable installs. Default uses each distro\'s own CDN.</string>
    <string name="app_desktop_mirror_default">Default (CDN)</string>
    <string name="app_desktop_mirror_europe">Europe</string>
    <string name="app_desktop_mirror_asia">Asia</string>
    <string name="app_desktop_mirror_americas">Americas</string>
    <string name="app_desktop_remap_ports_title">Remap low ports</string>
    <string name="app_desktop_remap_ports_description">Lets guest services listen on privileged ports (&lt;1024): a service on port N becomes reachable at N+2000 (e.g. 80 → 2080). Android blocks the app from binding low ports directly. Off by default; affects every privileged port, including a guest sshd.</string>
    <string name="app_desktop_share_storage_title">Share device storage with guest</string>
    <string name="app_desktop_share_storage_description">Mounts your shared storage into the guest at /storage and /sdcard so it can reach your files. Turn off to keep your photos and downloads hidden from the local Linux environment.</string>
    <!-- Guest DNS (#446): the hardcoded public resolvers failed silently on
         networks that only allow their own resolver. -->
    <string name="app_desktop_dns_title">Guest DNS</string>
    <string name="app_desktop_dns_description">Which name servers the local Linux guest uses. If package installs hang on this network, it may block public DNS \u2014 use the network\'s own resolver.</string>
    <string name="app_desktop_dns_mode_system">Network (DHCP)</string>
    <string name="app_desktop_dns_mode_public">Public (Google + Cloudflare)</string>
    <string name="app_desktop_dns_mode_custom">Custom</string>
    <string name="app_desktop_dns_custom_label">Name servers</string>
    <string name="app_desktop_dns_custom_hint">e.g. 10.0.0.53, 1.1.1.1</string>
    <string name="app_desktop_bind_android_system_title">Expose Android system to guest</string>
    <string name="app_desktop_bind_android_system_description">Mounts Android\'s read-only /system, /vendor, /apex and related partitions into the guest so it can run Android\'s own native binaries (e.g. getprop, toybox). Off by default: this exposes device and vendor internals to the local Linux environment.</string>
    <!-- Desktop manager: custom bind mounts (#301) -->
    <string name="app_desktop_custom_binds_title">Custom mounts (%1$d)</string>
    <string name="app_desktop_custom_binds_description">Expose extra Android paths inside this distro\'s guest, on top of the system mounts. Mounts are read-write.</string>
    <string name="app_desktop_custom_binds_dialog_title">Custom mounts — %1$s</string>
    <string name="app_desktop_custom_binds_host_hint">Android path (e.g. /storage/emulated/0/Sync)</string>
    <string name="app_desktop_custom_binds_guest_hint">Guest path (optional — defaults to the same path)</string>
    <string name="app_desktop_custom_binds_add">Add mount</string>
    <string name="app_desktop_custom_binds_empty">No custom mounts. Add one to expose an Android path in the guest.</string>
    <string name="app_desktop_custom_binds_remove_cd">Remove mount</string>
    <string name="app_desktop_custom_binds_takes_effect">Applies on the next shell, command, or desktop start for this distro.</string>
