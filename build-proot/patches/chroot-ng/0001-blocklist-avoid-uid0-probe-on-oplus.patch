+             * stdin was a silent datagram socket (ssh/CI harnesses).
+             *
+             * For setre*id/setres*id, passing 0 in arg1/arg2 requests UID/GID 0
+             * (since -1 in arg0 means "leave real id unchanged"). Android's
+             * zygote filter allows __NR_setresuid through to the kernel, where
+             * targeting UID 0 from an app UID trips OPlus CONFIG_OPLUS_ROOT_CHECK
+             * and raises a system-wide security warning dialog. Passing -1 in
+             * arg1/arg2 leaves all ids unchanged while still probing seccomp. */
+            int nr = probe_set[i];
+            long a1 = 0, a2 = 0;
+            if (nr == __NR_setreuid || nr == __NR_setregid ||
+                nr == __NR_setresuid || nr == __NR_setresgid) {
+                a1 = -1;
+                a2 = -1;
+            }
+            cng_syscall6(-1, a1, a2, 0, 0, 0, nr);
+        }
         sys_exit_group(0);
     }
