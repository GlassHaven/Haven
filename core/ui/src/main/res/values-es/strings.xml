    <string name="connections_fido_waiting_title">Se requiere llave de seguridad</string>
    <string name="connections_fido_waiting_body">Conecta tu llave de seguridad por USB o acércala a la parte trasera del dispositivo para NFC. Haven continuará automáticamente en cuanto la detecte.</string>
