    <string name="keys_security_key">Безбедосни кључ (YubiKey)</string>
    <string name="keys_security_key_hint">Подесите нови SSH кључ на FIDO2 кључу, или увезите кључеве који се већ налазе на њему.</string>
    <string name="keys_from_provider">Користи кључ из %1$s</string>
    <string name="keys_from_provider_hint">Изаберите кључ који држи апликација. Он потписује у Haven-ово име — приватни кључ остаје тамо где јесте, укључујући и на хардверском жетону.</string>
    <string name="keys_security_key_setup">Подеси нови кључ на њему</string>
    <string name="keys_security_key_setup_hint">Креира нови SSH кључ на безбедносном кључу (поставља PIN ако је нов). Није потребан лаптоп или ssh-keygen.</string>
    <string name="keys_security_key_import">Увези кључеве који су већ на њему</string>
    <string name="keys_security_key_import_hint">Додаје резидентне SSH-SK приступне информације које су већ смештене на кључ (направљене негде другде са ssh-keygen -O resident).</string>
    <string name="keys_register_on_security_key">Постави SSH кључ на безбедносном кључу</string>
    <string name="keys_register_on_security_key_body">Креира резидентне sk-ssh-ed25519 приступне информације на безбедносном кључу. Затим: прикључите га преко USB и притисните тастер, или тапните и задржите на задњој страни уређаја за NFC.</string>
    <string name="keys_register_verify_required">Захтевај PIN приликом сваке пријаве</string>
    <string name="keys_register_verify_required_hint">Укључено: кључ захтева свој PIN сваки пут када потписује SSH пријаву (потребна је потврда — јача безбедност). Искључено: довољан је само додир.</string>
